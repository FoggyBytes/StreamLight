<?xml version="1.0" encoding="utf-8"?>
<!--
  REVIEW COPY of the SignPath artifact configuration with slug "binaries".
  The SignPath portal is the source of truth: editing this file does not change signing.

  Used by: .github/workflows/build-windows.yml, first signing request
           ("Sign StreamLight.exe, AntiHooking.dll and the uninstaller").
  Input:   a zip (the GitHub Actions artifact StreamLight-X.Y.Z-binaries-to-sign) holding
           - StreamLight.exe and AntiHooking.dll, built from this repository;
           - Uninstaller.exe: Inno Setup's uninst-<inno>-<hash>.e64, renamed for the trip. It is
             both unins000.exe and the Setup program the installer runs from %TEMP%.
  Every file must say product name "StreamLight" and the product version the workflow passes
  (X.Y.Z.0), as the SignPath Foundation requires for every signed file.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="productVersion" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="StreamLight.exe" product-name="StreamLight" product-version="${productVersion}">
      <authenticode-sign />
    </pe-file>
    <pe-file path="AntiHooking.dll" product-name="StreamLight" product-version="${productVersion}">
      <authenticode-sign />
    </pe-file>
    <pe-file path="Uninstaller.exe" product-name="StreamLight" product-version="${productVersion}">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
